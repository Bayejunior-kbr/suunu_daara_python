# Copiez ce fichier en ".env" (jamais commité) et adaptez les valeurs.

# dev | testing | production
FLASK_CONFIG=dev
FLASK_APP=run:app

# Générez une vraie clé avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-production

# URI PostgreSQL — adapter utilisateur/mot de passe/hôte selon votre machine
DEV_DATABASE_URL=postgresql+psycopg2://daara_user:daara_pass@localhost:5432/daara_dev
TEST_DATABASE_URL=postgresql+psycopg2://daara_user:daara_pass@localhost:5432/daara_test
DATABASE_URL=postgresql+psycopg2://daara_user:daara_pass@localhost:5432/daara_prod
